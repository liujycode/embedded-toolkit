              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MR2</name>
              <description>线 2 中断屏蔽</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MR3</name>
              <description>线 3 中断屏蔽</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>PR</name>
          <description>挂起寄存器（写 1 清零）</description>
          <addressOffset>0x14</addressOffset>
