    {
      "id": "tim",
      "title": "定时器",
      "pitfalls": [
        {
          "id": "tim-arr",
          "title": "ARR/PSC 与实际频率对不上",
          "symptom": "周期差几倍",
          "fix": "公式反算回读：F = PCLK×(分频)/(PSC+1)/(ARR+1)",
          "keywords": [
            "定时器",
            "arr",
            "psc",
            "频率",
            "周期",
            "tim"
          ]
        },
        {
          "id": "tim-ug",
          "title": "只改 ARR 没产生更新事件",
          "symptom": "新周期下个周期才生效",
          "fix": "改完软触发 EGR 或等更新中断同步",
          "keywords": [
            "arr",
            "更新",
            "egr",
            "事件"
          ]
        },
        {
          "id": "tim-bdtr",
          "title": "互补输出没配死区/刹车",
          "symptom": "上下管直通炸管子",
          "fix": "功率级必配 BDTR 死区；电机语境转电机专家",
          "keywords": [
            "互补",
            "死区",
            "刹车",
            "bdtr",
            "直通"
          ]
        },
        {
          "id": "tim-enc",
          "title": "编码器模式读数跳变",
          "symptom": "计数异常",
          "fix": "查 TI1/TI2 极性与滤波器；机械问题转电机专家",
          "keywords": [
            "编码器",
            "encoder",
            "跳变",
            "ti1",
            "ti2"
          ]
        },
        {
          "id": "tim-cen",
          "title": "定时器配完忘了启动",
          "symptom": "配置全写进去了，就是不计数",
          "fix": "查 CR1 的 CEN 位——最后一步必须启动计数器",
          "keywords": [
            "tim",
