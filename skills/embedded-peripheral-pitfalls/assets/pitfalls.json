{
  "schema": "etk-pitfalls/1.0",
  "categories": [
    {
      "id": "adc",
      "title": "ADC",
      "pitfalls": [
        {
          "id": "adc-sample-time",
          "title": "采样时间太短",
          "symptom": "数据抖/精度差",
          "fix": "按信号源内阻配采样周期（datasheet 最小采样时间表）",
          "keywords": [
            "adc",
            "采样时间",
            "精度",
            "抖动"
          ]
        },
        {
          "id": "adc-cal",
          "title": "没做校准（F1/F3）",
          "symptom": "全体数据偏移",
          "fix": "上电先跑校准例程",
          "keywords": [
            "adc",
            "校准",
            "偏移",
            "cal"
          ]
        },
        {
          "id": "adc-inject",
          "title": "规则组/注入组概念混",
          "symptom": "采集顺序乱",
          "fix": "常规传感用规则组；注入组=高优先级插队（电机相电流用法归电机专家）",
          "keywords": [
            "adc",
            "规则组",
            "注入组",
            "顺序"
          ]
        },
        {
          "id": "adc-vref",
          "title": "VREF 没接好/参考电压漂",
          "symptom": "数据整体比例错",
          "fix": "硬件查 VDDA/VREF+；软件用内部 VREFINT 反算校准",
          "keywords": [
            "adc",
            "vref",
            "参考电压",
            "比例",
            "vrefint"
          ]
        },
        {
          "id": "adc-dma-mem",
          "title": "DMA 缓冲区不可达（H7 DTCM）",
          "symptom": "DMA 静默不搬",
          "fix": "缓冲放 AXI SRAM/D2 域或查总线矩阵",
          "keywords": [
            "adc",
            "dma",
            "dtcm",
            "h7",
            "不搬",
            "静默"
          ]
        },
        {
          "id": "adc-seqlen",
          "title": "转换序列长度没配",
          "symptom": "只有第一个通道有数据",
          "fix": "规则序列要写 SQR 的 L 位（序列长度-1）与各 rank 的通道号",
          "keywords": [
            "adc",
            "序列",
            "sqr",
            "多通道",
            "rank"
          ]
        },
        {
          "id": "adc-cal-aden",
          "title": "带着使能去校准",
          "symptom": "校准失败/校准后精度仍差",
          "fix": "新系列（G4/H7 等）校准前置条件是 ADEN=0——先关使能再校准，校准完再使能",
          "keywords": [
            "adc",
            "校准",
            "aden",
            "cal",
            "顺序"
          ]
        }
      ]
    },
    {
      "id": "can",
      "title": "CAN / FDCAN",
      "pitfalls": [
        {
          "id": "can-bit-timing",
          "title": "位时序段配错（采样点位置）",
          "symptom": "总线上偶发错误帧",
          "fix": "采样点 75-87.5%，用位时序计算器算",
          "keywords": [
            "can",
            "位时序",
            "采样点",
            "错误帧",
            "fdcan"
          ]
        },
        {
          "id": "can-filter",
          "title": "过滤器没配对",
          "symptom": "收不到任何报文",
          "fix": "先全收（掩码全 0）验证链路，再收紧过滤",
          "keywords": [
            "can",
            "过滤器",
            "filter",
            "收不到"
          ]
        },
        {
          "id": "can-tx-full",
          "title": "TX 邮箱满没等",
          "symptom": "发送丢帧",
          "fix": "查邮箱空标志或用 FIFO 模式",
          "keywords": [
            "can",
            "邮箱",
            "tx",
            "丢帧",
            "fifo"
          ]
        },
        {
          "id": "can-term",
          "title": "终端电阻缺失",
          "symptom": "边沿畸变通信不稳",
          "fix": "总线两端 120Ω，示波器看波形",
          "keywords": [
            "can",
            "终端电阻",
            "120",
            "边沿"
          ]
        },
        {
          "id": "can-loopback",
          "title": "没有先做环回自测",
          "symptom": "分不清是总线/收发器问题还是代码问题",
          "fix": "先用环回模式（loopback）自发自收验证代码，再上真实总线",
          "keywords": [
            "can",
            "环回",
            "自测",
            "loopback",
            "调试"
          ]
        },
        {
          "id": "fdcan-clock",
          "title": "FDCAN 内核时钟没选对",
          "symptom": "位时序怎么调都错/通信速率不对",
          "fix": "FDCAN 的内核时钟要单独选源使能，位时序按它计算——内核时钟错了采样点全错",
          "keywords": [
            "can",
            "fdcan",
            "内核时钟",
            "位时序",
            "采样点"
          ]
        }
      ]
    },
    {
      "id": "exti",
      "title": "EXTI / NVIC 中断",
      "pitfalls": [
        {
          "id": "exti-flag",
          "title": "标志位没清/清错位置",
          "symptom": "中断只进一次或狂进",
          "fix": "严格按 RM 的清除顺序（EXTI 的 PR 写 1 清零）",
          "keywords": [
            "中断",
            "标志位",
            "清除",
            "exti",
            "pr",
            "只进一次"
          ]
        },
        {
          "id": "exti-group",
          "title": "优先级分组理解错",
          "symptom": "嵌套行为和预期不符",
          "fix": "全工程统一一个分组，只初始化一次",
          "keywords": [
            "优先级",
            "分组",
            "嵌套",
            "nvic"
          ]
        },
        {
          "id": "exti-slow-isr",
          "title": "高优先级中断里做慢活",
          "symptom": "低优先级中断饿死/看门狗复位",
          "fix": "ISR 只做取数据+置标志，活儿丢给主循环/任务",
          "keywords": [
            "中断",
            "isr",
            "慢",
            "饿死",
            "看门狗"
          ]
        },
        {
          "id": "exti-rtos-prio",
          "title": "FreeRTOS：超 MAX_SYSCALL 优先级调 API",
          "symptom": "直接挂死",
          "fix": "中断优先级数值 ≥ configMAX_SYSCALL（数值大=优先级低）",
          "keywords": [
            "freertos",
            "中断",
            "优先级",
            "max_syscall",
            "挂死"
          ]
        },
        {
          "id": "exti-line-map",
          "title": "EXTI 线映射配错（同一号线多端口）",
          "symptom": "配置了 PB0 的外部中断，实际响应的是 PA0（或没响应）",
          "fix": "同一号线只能选一个端口——EXTICR 映射寄存器要配对",
          "keywords": [
            "exti",
            "映射",
            "exticr",
            "端口",
            "引脚"
          ]
        },
        {
          "id": "exti-nvic",
          "title": "EXTI 使能了但 NVIC 没开",
          "symptom": "pending 置位但就是不进中断",
          "fix": "EXTI 的 IMR/EMR + NVIC 的 ISER/优先级，两层使能缺一不可",
          "keywords": [
            "exti",
            "nvic",
            "使能",
            "pending",
            "不进中断"
          ]
        }
      ]
    },
    {
      "id": "gpio",
      "title": "GPIO",
      "pitfalls": [
        {
          "id": "gpio-af",
          "title": "复用没切 AF 模式",
          "symptom": "外设完全无输出",
          "fix": "读 MODER/AFR 回读确认",
          "keywords": [
            "gpio",
            "复用",
            "af",
            "无输出",
            "moder"
          ]
        },
        {
          "id": "gpio-i2c-pushpull",
          "title": "I2C 引脚配成推挽",
          "symptom": "总线卡死/烧器件",
          "fix": "I2C 必须 AF+开漏+上拉（4.7k 典型）",
          "keywords": [
            "i2c",
            "推挽",
            "开漏",
            "上拉",
            "卡死"
          ]
        },
        {
          "id": "gpio-5v",
          "title": "非 FT 引脚接 5V",
          "symptom": "电平不匹配/引脚损坏",
          "fix": "查 datasheet 的 FT（five volt tolerant）标记",
          "keywords": [
            "5v",
            "ft",
            "电平",
            "容忍"
          ]
        },
        {
          "id": "gpio-analog",
          "title": "模拟脚没设模拟模式",
          "symptom": "ADC 采集噪声大",
          "fix": "模拟外设引脚设 analog 模式并关施密特触发器",
          "keywords": [
            "模拟",
            "analog",
            "噪声",
            "adc"
          ]
        },
        {
          "id": "gpio-af-conflict",
          "title": "两个外设抢同一个引脚",
          "symptom": "其中一个外设莫名失效（后配置的把复用抢走）",
          "fix": "对照引脚复用表做全局分配；初始化顺序定好并注释谁在用哪个引脚",
          "keywords": [
            "gpio",
            "复用",
            "冲突",
            "引脚分配"
          ]
        },
        {
          "id": "gpio-speed",
          "title": "输出速率档位没配",
          "symptom": "高速信号边沿畸变、EMI 超标",
          "fix": "按信号速率选 OSPEEDR 档位；低速信号降档降 EMI",
          "keywords": [
            "gpio",
            "速率",
            "ospeed",
            "边沿",
            "emi"
          ]
        }
      ]
    },
    {
      "id": "i2c",
      "title": "I2C",
      "pitfalls": [
        {
          "id": "i2c-pullup",
          "title": "上拉电阻没接/太大",
          "symptom": "SDA/SCL 上不去高电平",
          "fix": "示波器看上升沿；4.7k 起步按总线电容调",
          "keywords": [
            "i2c",
            "上拉",
            "电阻",
            "上升沿"
          ]
        },
        {
          "id": "i2c-addr",
          "title": "从机地址 7 位/8 位写法混",
          "symptom": "NAK（地址都不对）",
          "fix": "看清 HAL API 约定（7 位地址是否需左移）",
          "keywords": [
            "i2c",
            "地址",
            "7位",
            "8位",
            "nak"
          ]
        },
        {
          "id": "i2c-stuck",
          "title": "总线被从机拉死",
          "symptom": "SDA 一直低",
          "fix": "9 脉冲解救时序或断电重启外设",
          "keywords": [
            "i2c",
            "总线",
            "拉死",
            "sda",
            "解救"
          ]
        },
        {
          "id": "i2c-f1-sr",
          "title": "读 SR 后必须读 DR 的老 F1 陷阱",
          "symptom": "标志位顺序错乱卡在 EV 里",
          "fix": "严格按状态机图（F1 尤甚，G4/H7 已简化）",
          "keywords": [
            "i2c",
            "f1",
            "sr",
            "dr",
            "ev",
            "状态机"
          ]
        },
        {
          "id": "i2c-stretch",
          "title": "时钟拉伸没考虑",
          "symptom": "快从机数据丢",
          "fix": "查从机 datasheet 支持的速率（400k/1000k）",
          "keywords": [
            "i2c",
            "时钟拉伸",
            "stretch",
            "速率"
          ]
        },
        {
          "id": "i2c-timeout-recovery",
          "title": "总线挂死没有恢复机制",
          "symptom": "一次从机拉死，之后永久瘫痪",
          "fix": "驱动里加超时+恢复路径（9 脉冲/外设复位/重上电），别裸等标志",
          "keywords": [
            "i2c",
            "超时",
            "恢复",
            "拉死",
            "健壮性"
          ]
        }
      ]
    },
    {
      "id": "pwr",
      "title": "低功耗 PWR",
      "pitfalls": [
        {
          "id": "pwr-wake-clock",
          "title": "唤醒后时钟回落没重配",
          "symptom": "唤醒后串口乱码、定时不准",
          "fix": "唤醒后重跑时钟初始化（PLL 重启+切换）；外设时钟源重算",
          "keywords": [
            "低功耗",
            "唤醒",
            "时钟",
            "pll",
            "hsi",
            "msi"
          ]
        },
        {
          "id": "pwr-wakeup-flag",
          "title": "进睡前唤醒标志没清",
          "symptom": "进不了低功耗或立刻被唤醒",
          "fix": "先清唤醒标志再使能唤醒源最后进低功耗，顺序别乱",
          "keywords": [
            "低功耗",
            "唤醒标志",
            "wuf",
            "顺序"
          ]
        },
        {
          "id": "pwr-sram-retention",
          "title": "待机模式 SRAM 不保持",
          "symptom": "standby 醒来变量丢了",
          "fix": "待机模式 SRAM 内容不保持——要保留数据换 stop 模式，或用保持域/备份域",
          "keywords": [
            "低功耗",
            "standby",
            "sram",
            "保持",
            "数据丢失"
          ]
        },
        {
          "id": "pwr-gpio-leak",
          "title": "低功耗电流降不下来先查引脚",
          "symptom": "进了停机电流仍偏大",
          "fix": "悬空引脚配模拟输入防漏电；查调试口/外设时钟是否关干净",
          "keywords": [
            "低功耗",
            "漏电",
            "引脚",
            "电流",
            "模拟"
          ]
        }
      ]
    },
    {
      "id": "rcc",
      "title": "RCC / 时钟",
      "pitfalls": [
        {
          "id": "rcc-no-enable",
          "title": "外设时钟没开就访问寄存器",
          "symptom": "HardFault（PRECISERR）或写入无效",
          "fix": "使能后回读外设寄存器验证；宁可多开不可漏",
          "keywords": [
            "时钟",
            "使能",
            "rcc",
            "hardfault",
            "写入无效",
            "preciserr"
          ]
        },
        {
          "id": "rcc-vos",
          "title": "PLL 超频电压档没跟上",
          "symptom": "系统不稳/起不来",
          "fix": "查 H7/F4 的 VOS 电压档位与频率对应表",
          "keywords": [
            "pll",
            "vos",
            "超频",
            "电压",
            "不稳"
          ]
        },
        {
          "id": "rcc-hsi-uart",
          "title": "HSI 精度当晶振用",
          "symptom": "UART 长距离通信乱码",
          "fix": "HSI ±1% 精度，UART 误差>2% 误码；时钟源换 HSE",
          "keywords": [
            "hsi",
            "hse",
            "精度",
            "乱码",
            "波特率",
            "uart"
          ]
        },
        {
          "id": "rcc-tim-clk",
          "title": "定时器时钟源选错（APB×1 vs ×2）",
          "symptom": "定时周期差一倍",
          "fix": "APB 分频>1 时定时器时钟 = PCLK×2",
          "keywords": [
            "定时器",
            "apb",
            "分频",
            "周期",
            "tim"
          ]
        },
        {
          "id": "rcc-lse-startup",
          "title": "LSE 起振慢或不起，RTC 走不准",
          "symptom": "RTC 停走/走时异常，等 LSERDY 超时",
          "fix": "查 32.768k 晶振负载电容；起振等待要带超时兜底（起振失败走 LSI 并报错）",
          "keywords": [
            "rcc",
            "lse",
            "rtc",
            "晶振",
            "超时"
          ]
        },
        {
          "id": "rcc-mco",
          "title": "MCO 引脚看不到时钟",
          "symptom": "示波器上 MCO 无输出",
          "fix": "MCO 也要配 AF 复用；查 MCO 源选择与分频是否生效",
          "keywords": [
            "rcc",
            "mco",
            "时钟输出",
            "示波器"
          ]
        }
      ]
    },
