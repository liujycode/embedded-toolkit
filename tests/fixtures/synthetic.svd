<?xml version="1.0" encoding="utf-8"?>
<!--
  合成测试夹具：不对应任何真实芯片，专门覆盖解析器的各个分支。
  所有期望值都可以按本文件手算，见 tests/test_svd.py 与 tests/test_query.py。
-->
<device schemaVersion="1.1">
  <name>SYNTH32</name>
  <version>1.0</version>
  <description>Synthetic device for embedded-toolkit tests</description>
  <vendor>SYNTH-Corp</vendor>
  <cpu>
    <name>CM4</name>
    <revision>r0p1</revision>
    <endian>little</endian>
  </cpu>
  <width>32</width>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>USART1</name>
      <description>Synthetic USART 1</description>
      <groupName>USART</groupName>
      <baseAddress>0x40013800</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>USART1_IRQn</name>
        <description>USART1 global interrupt</description>
        <value>37</value>
      </interrupt>
      <registers>
        <register>
          <name>CR1</name>
          <description>Control register 1</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>UE</name>
              <description>USART enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TE</name>
              <description>Transmitter enable</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PS</name>
              <description>Parity selection</description>
              <bitRange>[9:9]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EVEN</name>
                  <description>Even parity</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ODD</name>
                  <description>Odd parity</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DEFAULT</name>
                  <isDefault>true</isDefault>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>M0</name>
              <description>Word length</description>
              <bitRange>[12:12]</bitRange>
            </field>
            <field>
              <name>OVER8</name>
              <description>Oversampling mode</description>
              <lsb>15</lsb>
              <msb>15</msb>
            </field>
          </fields>
        </register>
        <register>
          <name>BRR</name>
          <description>Baud rate register</description>
          <addressOffset>0x0C</addressOffset>
          <fields>
            <field>
              <name>DIV</name>
              <description>Baud rate divisor</description>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>SR</name>
          <description>Status register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-only</access>
          <resetValue>0x000000C0</resetValue>
          <fields>
            <field>
              <name>TXE</name>
              <description>Transmit data register empty</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TC</name>
              <description>Transmission complete</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral derivedFrom="USART1">
      <name>USART2</name>
      <baseAddress>0x40004400</baseAddress>
    </peripheral>

    <peripheral derivedFrom="USART1">
      <name>USART3</name>
      <baseAddress>0x40004800</baseAddress>
      <interrupt>
        <name>USART3_IRQn</name>
        <value>39</value>
      </interrupt>
      <registers>
        <register>
          <name>SR</name>
          <addressOffset>0x1C</addressOffset>
          <resetValue>0x00000040</resetValue>
          <fields>
            <field>
              <name>TXE</name>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>GPIO%s</name>
      <description>Synthetic GPIO port</description>
      <dim>3</dim>
      <dimIncrement>0x400</dimIncrement>
      <dimIndex>A-C</dimIndex>
      <baseAddress>0x48000000</baseAddress>
      <size>32</size>
      <resetValue>0x00000001</resetValue>
      <registers>
        <register>
          <name>MODER</name>
          <addressOffset>0x00</addressOffset>
          <fields>
            <field>
              <name>MODE0</name>
              <description>Port mode bit 0</description>
              <bitRange>[1:0]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INPUT</name>
                  <value>#00</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OUTPUT</name>
                  <value>#01</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALTERNATE</name>
                  <value>#10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANALOG</name>
                  <value>#11</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ODR</name>
          <addressOffset>0x14</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>OD0</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DMA1</name>
      <baseAddress>0x40020000</baseAddress>
      <interrupt>
        <name>DMA1_Channel1_IRQn</name>
        <description>DMA1 channel 1 interrupt</description>
        <value>11</value>
      </interrupt>
      <interrupt>
        <name>DMA1_Channel2_IRQn</name>
        <value>12</value>
      </interrupt>
      <registers>
        <register>
          <name>ISR</name>
          <addressOffset>0x00</addressOffset>
          <fields>
            <field>
              <name>GIF1</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <cluster>
          <name>CH%s</name>
          <description>DMA channel</description>
          <dim>2</dim>
          <dimIncrement>0x14</dimIncrement>
          <dimIndex>1-2</dimIndex>
          <addressOffset>0x08</addressOffset>
          <register>
            <name>CCR</name>
            <addressOffset>0x00</addressOffset>
            <fields>
              <field>
                <name>EN</name>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
              </field>
              <field>
                <name>DIR</name>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
              </field>
            </fields>
          </register>
          <register>
            <name>CNDTR</name>
            <addressOffset>0x04</addressOffset>
            <fields>
              <field>
                <name>NDT</name>
                <bitRange>[15:0]</bitRange>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>

    <peripheral>
      <name>TIM1</name>
      <baseAddress>0x40012C00</baseAddress>
      <registers>
        <register>
          <name>CR1</name>
          <description>TIM1 control register 1</description>
          <addressOffset>0x00</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>CEN</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DIR</name>
              <lsb>4</lsb>
              <msb>4</msb>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UP</name>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DOWN</name>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register derivedFrom="CR1">
          <name>CR1S</name>
          <addressOffset>0x10</addressOffset>
        </register>
        <register>
          <name>CR2</name>
          <addressOffset>0x04</addressOffset>
          <fields>
            <field>
              <name>MMS</name>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RESET</name>
                  <value>#000</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <value>#001</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMPARE</name>
                  <value>#1XX</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CNT</name>
          <addressOffset>0x24</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>CNT</name>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CCR%s</name>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>1-4</dimIndex>
          <addressOffset>0x34</addressOffset>
          <fields>
            <field>
              <name>CCR</name>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>RCC</name>
      <baseAddress>0x40021000</baseAddress>
      <registers>
        <register>
          <name>CR</name>
          <addressOffset>0x00</addressOffset>
          <resetValue>0x00000500</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          <fields>
            <field>
              <name>HSION</name>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>HSIRDY</name>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>APB1ENR</name>
          <addressOffset>0x58</addressOffset>
          <fields>
            <field>
              <name>USART2EN</name>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>I2C1EN</name>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>EXTI</name>
      <description>External interrupt/event controller</description>
      <baseAddress>0x40010400</baseAddress>
      <registers>
        <register>
          <name>PR</name>
          <description>Pending register</description>
          <addressOffset>0x14</addressOffset>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>P0</name>
              <description>Pending bit 0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <readAction>clear</readAction>
            </field>
            <field>
              <name>P1</name>
              <description>Pending bit 1</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>NVIC</name>
      <description>嵌套向量中断控制器（Synthetic）</description>
      <groupName>NVIC</groupName>
      <baseAddress>0xE000E100</baseAddress>
      <registers>
        <register>
          <name>ISER0</name>
          <description>中断使能寄存器 0（中断 0-31）</description>
          <addressOffset>0x00</addressOffset>
        </register>
        <register>
          <name>ISER1</name>
          <description>中断使能寄存器 1（中断 32-63）</description>
          <addressOffset>0x04</addressOffset>
        </register>
        <register>
          <name>ICPR0</name>
          <description>中断清挂起寄存器 0</description>
          <addressOffset>0x280</addressOffset>
        </register>
        <register>
          <name>ICPR1</name>
          <description>中断清挂起寄存器 1</description>
          <addressOffset>0x284</addressOffset>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
